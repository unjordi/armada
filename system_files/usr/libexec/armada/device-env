#!/bin/bash
set -euo pipefail

device_dir=${ARMADA_DEVICE_DIR:-/usr/lib/armada/devices}

source "$device_dir/defaults.conf"

model=${ARMADA_MODEL:-}
if [[ -z "$model" ]]; then
    model=$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null || true)
fi
case "$model" in
    "AYANEO Pocket EVO") profile=ayaneo-pocket-evo ;;
    "AYN Odin 2") profile=ayn-odin-2 ;;
    "AYN Odin 2 Mini") profile=ayn-odin-2-mini ;;
    "AYN Odin 2 Portal") profile=ayn-odin-2-portal ;;
    "AYN Thor") profile=ayn-thor ;;
    "AYN Thor Lite") profile=ayn-thor-lite ;;
    "AYANEO Pocket ACE") profile=ayaneo-pocket-ace ;;
    "AYANEO Pocket DMG") profile=ayaneo-pocket-dmg ;;
    "AYANEO Pocket DS") profile=ayaneo-pocket-ds ;;
    "AYANEO Pocket S 1K") profile=ayaneo-pocket-s1k ;;
    "AYANEO Pocket S 2K") profile=ayaneo-pocket-s2k ;;
    "AYANEO Pocket S2") profile=ayaneo-pocket-s2 ;;
    "KONKR Pocket FIT") profile=konkr-pocket-fit ;;
    "KONKR Pocket FIT Elite") profile=konkr-pocket-fit-elite ;;
    "AYN Odin 3") profile=ayn-odin-3 ;;
    "Retroid Pocket 5") profile=retroid-pocket-5 ;;
    "Retroid Pocket 5 Visionox") profile=retroid-pocket-5 ;;
    "Retroid Pocket Flip2") profile=retroid-pocket-flip2 ;;
    "Retroid Pocket Flip2 Visionox") profile=retroid-pocket-flip2 ;;
    "Retroid Pocket Mini") profile=retroid-pocket-mini ;;
    "Retroid Pocket Mini V2") profile=retroid-pocket-mini-v2 ;;
    "Retroid Pocket 6") profile=retroid-pocket-6 ;;
    "Retroid Pocket 6 TOP-DPAD") profile=retroid-pocket-6 ;;
    "Retroid Pocket Nova") profile=retroid-pocket-nova ;;
    *) profile= ;;
esac

if [[ -n "$profile" && -r "$device_dir/$profile.conf" ]]; then
    source "$device_dir/$profile.conf"
fi

profile_suspend_mode=${ARMADA_SUSPEND_MODE:-fake}

# Deep suspend is a per-device VALIDATED capability, not just a kernel one: a
# model is cleared for deep only after deep-charge + resume are verified on that
# hardware. A device .conf declares validation in its own idiom -- either by
# making deep the default (ARMADA_SUSPEND_MODE=deep, as the RP6 does) or, to
# clear deep without making it the default, ARMADA_SUSPEND_DEEP_VALIDATED=1.
# defaults.conf keeps the fleet floor at 0, so an unvalidated model never runs
# deep even on a kernel that advertises it.
deep_validated=${ARMADA_SUSPEND_DEEP_VALIDATED:-0}
if [[ "$profile_suspend_mode" == deep ]]; then
    deep_validated=1
fi

mem_sleep=${ARMADA_MEM_SLEEP_PATH:-/sys/power/mem_sleep}
mem_sleep_modes=
if [[ -r "$mem_sleep" ]]; then
    mem_sleep_modes=$(<"$mem_sleep")
fi

sleep_config=${ARMADA_SLEEP_CONFIG:-/etc/armada/sleep.conf}
if [[ -r "$sleep_config" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^[[:space:]]*suspend_mode[[:space:]]*=[[:space:]]*(fake|s2idle|deep)[[:space:]]*$ ]]; then
            suspend_mode=${BASH_REMATCH[1]}
            if [[ "$suspend_mode" == fake ]] || grep -qw "$suspend_mode" <<<"$mem_sleep_modes"; then
                ARMADA_SUSPEND_MODE=$suspend_mode
            else
                ARMADA_SUSPEND_MODE=$profile_suspend_mode
            fi
        fi
    done <"$sleep_config"
fi
# Fleet gate for deep: it runs only when BOTH compuertas pass -- (1) the running
# kernel advertises deep in mem_sleep (checked just below) AND (2) this model is
# validated for deep. An unvalidated model that asked for deep (a profile that
# never validates cannot, but a user /etc/armada/sleep.conf override can) falls
# back to its profile default -- s2idle for the fleet -- instead of running deep
# on unvetted hardware.
if [[ "$ARMADA_SUSPEND_MODE" == deep && "$deep_validated" != 1 ]]; then
    ARMADA_SUSPEND_MODE=$profile_suspend_mode
fi

# Never hand systemd-sleep a mode the running kernel cannot do (including a
# profile default): a real mode that mem_sleep does not advertise degrades to
# fake so suspend still happens instead of failing.
if [[ "$ARMADA_SUSPEND_MODE" != fake ]] &&
    ! grep -qw "$ARMADA_SUSPEND_MODE" <<<"$mem_sleep_modes"; then
    ARMADA_SUSPEND_MODE=fake
fi

# Proton defaults are tried in order and must match Steam compatibility
# tool IDs.
if [[ "${ARMADA_SOC_CLASS:-}" == SM8250 ]]; then
    ARMADA_PROTON_DEFAULTS=proton-cachyos-11.0-arm64
else
    ARMADA_PROTON_DEFAULTS=proton-experimental-arm64:proton_11-arm64:proton-cachyos-11.0-arm64
fi

# CPU topology by SoC (device conf may override). Cpulists are ordered:
# presets expand in host order, WINE_CPU_TOPOLOGY consumers keep the order.
# BIG includes the prime cores; PRIME is the strict subset. Empty
# ARMADA_IRQ_CORES means no IRQ restriction.
case "${ARMADA_SOC_CLASS:-}" in
    SM8250)
        : "${ARMADA_LITTLE_CORES=0-3}"
        : "${ARMADA_BIG_CORES=4-7}"
        : "${ARMADA_PRIME_CORES=7}"
        # references run SM8250 unrestricted; the A55s are too weak to
        # carry all IRQ handling
        : "${ARMADA_IRQ_CORES=}"
        ;;
    SM8550)
        : "${ARMADA_LITTLE_CORES=0-2}"
        : "${ARMADA_BIG_CORES=3-7}"
        : "${ARMADA_PRIME_CORES=7}"
        # The A740 GMU wedges if a GPU interrupt wakes CPU 0-2 out of power collapse
        : "${ARMADA_IRQ_CORES=3-7}"
        ;;
    SM8650)
        : "${ARMADA_LITTLE_CORES=0-1}"
        : "${ARMADA_BIG_CORES=2-7}"
        : "${ARMADA_PRIME_CORES=7}"
        : "${ARMADA_IRQ_CORES=0-1}"
        ;;
    SM8750)
        : "${ARMADA_LITTLE_CORES=}"
        : "${ARMADA_BIG_CORES=0-7}"
        : "${ARMADA_PRIME_CORES=6-7}"
        : "${ARMADA_IRQ_CORES=}"
        ;;
esac

# Publish the resolved validation state so the UI/backend read one source of
# truth (whether to offer deep enabled or greyed) instead of re-deriving it.
ARMADA_SUSPEND_DEEP_VALIDATED=$deep_validated

vars=(
    ARMADA_DEVICE_ID
    ARMADA_DEVICE_NAME
    ARMADA_SOC_CLASS
    ARMADA_PROTON_DEFAULTS
    ARMADA_SUSPEND_MODE
    ARMADA_SUSPEND_DEEP_VALIDATED
    ARMADA_SYNC_SUSPEND
    ARMADA_PRIMARY_CONNECTOR
    ARMADA_PRIMARY_BACKLIGHT
    ARMADA_SECONDARY_CONNECTOR
    ARMADA_SECONDARY_BACKLIGHT
    ARMADA_VIRTUAL_KEYBOARD_CONNECTOR
    ARMADA_PRIMARY_TOUCHSCREEN
    ARMADA_SECONDARY_TOUCHSCREEN
    ARMADA_PANEL_TYPE
    ARMADA_PANEL_ORIENTATION
    ARMADA_GAMESCOPE_USE_ROTATION_SHADER
    ARMADA_HDR_NITS
    ARMADA_GAMEPAD_QUIRK
    ARMADA_IP_TARGETS
    ARMADA_LITTLE_CORES
    ARMADA_BIG_CORES
    ARMADA_PRIME_CORES
    ARMADA_IRQ_CORES
)

for var in "${vars[@]}"; do
    printf '%s=%q\n' "$var" "${!var:-}"
done
