#!/bin/bash
# Keep the fan spinning across suspend ONLY while charging, so a battery-heating
# deep-suspend charge still gets airflow (no CPU is up to run the thermal loop in
# deep). This is the charging gate for the pwm-fan `suspend_pwm` knob (kernel
# patch 0502): it writes a static floor before suspend when charging, and 0
# otherwise, so on battery the fan powers off as usual (no drain). It is a no-op
# where the knob is absent (kernels without the patch) or where the fan-supply
# rail is still cut in suspend (DT still has regulator-off-in-suspend).
set -uo pipefail

sysfs_root=${ARMADA_SYSFS_ROOT:-/sys}
knob=${ARMADA_PWM_FAN_SUSPEND_KNOB:-/sys/module/pwm_fan/parameters/suspend_pwm}
floor_file=${ARMADA_FAN_SUSPEND_CHARGING_PWM_FILE:-/etc/armada/fan-suspend-charging-pwm}
# Static PWM (0..255) held across suspend while charging. Not temperature-
# responsive: with the AP down in deep nothing can re-target it. Override by
# writing an integer to $floor_file.
default_floor=${ARMADA_FAN_SUSPEND_CHARGING_PWM:-176}

[[ "${2:-}" == suspend ]] || exit 0
[[ -w "$knob" ]] || exit 0   # kernel without the patch -> nothing to do

write_knob() { printf '%s\n' "$1" >"$knob" 2>/dev/null || true; }

battery_charging() {
    local status
    for status in "$sysfs_root"/class/power_supply/*/status; do
        [[ -r "$status" ]] || continue
        read -r s <"$status" 2>/dev/null || continue
        [[ "$s" == Charging ]] && return 0
    done
    return 1
}

resolve_floor() {
    local v="$default_floor"
    if [[ -r "$floor_file" ]]; then
        read -r fv <"$floor_file" 2>/dev/null || fv=""
        [[ "$fv" =~ ^[0-9]+$ ]] && v="$fv"
    fi
    (( v < 0 )) && v=0
    (( v > 255 )) && v=255
    printf '%s' "$v"
}

case "${1:-}" in
    pre)
        if battery_charging; then
            write_knob "$(resolve_floor)"
        else
            write_knob 0
        fi
        ;;
    post)
        # Back to stock suspend behaviour while awake; armada-powerd owns the fan.
        write_knob 0
        ;;
esac
exit 0
